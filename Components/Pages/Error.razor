@page "/Error"

<PageTitle>Fehler</PageTitle>

<section class="empty-state" aria-labelledby="error-title">
    <span class="empty-state__icon empty-state__icon--error" aria-hidden="true">!</span>
    <h1 id="error-title">Unerwarteter Fehler</h1>
    <p>Die Anwendung konnte die Aktion nicht abschliessen. Bitte kehre zur Übersicht zurück und versuche es erneut.</p>
    <a class="button button--primary" href="/">Zur Übersicht</a>
</section>
